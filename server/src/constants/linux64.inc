; src/constants/linux64.inc

SYS_WRITE   equ 0x01
SYS_EXIT    equ 0x3C
SYS_SOCKET  equ 0x29
SYS_BIND    equ 0x31
SYS_CONNECT equ 0x2A
SYS_LISTEN  equ 0x32
SYS_CLOSE   equ 0x03
SYS_ACCEPT  equ 0x2B

SYS_EPOLL_CREATE  equ 0xD5
SYS_EPOLL_WAIT    equ 0xE8
SYS_EPOLL_CTL     equ 0xE9

STDOUT equ 0x1
STDERR equ 0x2

; sys/socket.h
AF_INET   equ 0x02
AF_INET6  equ 0x0A

SOCK_STREAM     equ 0x1
SOCK_DGRAM      equ 0x2
SOCK_SEQPACKET  equ 0x5
SOCK_NONBLOCK

; sys/epoll.h
; ops
EPOLL_CTL_ADD equ 0x01
EPOLL_CTL_MOD equ 0x03
EPOLL_CTL_DEL equ 0x02

; events:
EPOLLIN equ 0x01
EPOLLOUT equ 0x04
EPOLLRDHUP equ 0x2000
EPOLLPRI equ 0x02
EPOLLERR equ 0x08
EPOLLHUP equ 0x10

; input flags
EPOLLET equ 0x80000000
EPOLLONESHOT equ 0x40000000
EPOLLWAKEUP equ 0x20000000
EPOLLEXCLUSIVE equ 0x10000000

